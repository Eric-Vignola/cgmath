__pycache__/
*.py[cod]

# numba writes its on-disk kernel cache next to the sources
*.nbi
*.nbc

.claude/

# Packaging artifacts. `python -m build` writes the wheel and sdist into
# dist/, and setuptools drops an egg-info beside the sources; the release
# assets live on GitHub, not in the repository.
build/
dist/
*.egg-info/
